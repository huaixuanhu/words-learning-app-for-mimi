# Real values are generated by Vercel / Neon and kept in ignored .env.local.
# The local development scripts accept any one of these connection URLs.
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# Optional runtime adapter flags. Leave empty by default.
# MIMI_STORAGE_RUNTIME accepts local, postgres-preview, or postgres-production.
# Use postgres-preview only outside Vercel Production; use postgres-production only in Vercel Production.
MIMI_STORAGE_RUNTIME=
MIMI_ENABLE_STORAGE_SMOKE_WRITES=
MIMI_ENABLE_STORAGE_UI_WRITES=

# Required in Vercel Production. Keep the password server-only and sensitive.
MIMI_BASIC_AUTH_USER=
MIMI_BASIC_AUTH_PASSWORD=
# V2-8-3 requires one exact state: maintenance, schema6-readiness, or live.
# Missing or unknown values keep authenticated Production traffic closed.
MIMI_PRODUCTION_CUTOVER_MODE=

# Shared formal AI runtime names. Scope every real value to exactly one
# environment. Production must use a different study secret and Gemini key
# from protected Preview. Keep both values server-only and sensitive.
STAGE5F_DATABASE_TARGET=
STAGE6B_DATABASE_TARGET=
MIMI_STUDY_TOKEN_SECRET=
MIMI_AI_EXECUTION_SCOPE=
MIMI_AI_RUNTIME_ENABLED=
MIMI_AI_ACCOUNTING_READY=
MIMI_AI_SCHEMA6_READY=
MIMI_AI_KILL_SWITCH=
MIMI_AI_QUOTA_AVAILABLE=
MIMI_AI_AUTH_KEY_TYPE_CONFIRMED=
MIMI_AI_PROJECT_LOGGING_DISABLED_CONFIRMED=
MIMI_V2_8_2_STAGING_TARGET_CONFIRMED=
MIMI_V2_8_2_PREVIEW_PROTECTED_CONFIRMED=
MIMI_AI_PREVIEW_ROLLOUT_MAX_PROVIDER_ATTEMPTS=

# V2-8-3 Production-only confirmations. Leave empty outside the separately
# approved Production rollout. Initial opening uses the four-attempt ceiling;
# steady state requires its own acceptance instead of silently dropping it.
MIMI_V2_8_3_PRODUCTION_TARGET_CONFIRMED=
MIMI_V2_8_3_PRODUCTION_ACCESS_CONFIRMED=
MIMI_V2_8_3_PRODUCTION_KEY_CONFIRMED=
MIMI_AI_PRODUCTION_ROLLOUT_MAX_PROVIDER_ATTEMPTS=
MIMI_V2_8_3_PRODUCTION_STEADY_STATE_ACCEPTED=
GEMINI_API_KEY=

# V2-8-3 database-command guards for a separately approved shell session, not
# ordinary app runtime settings or Vercel settings. NEON_API_KEY is a sensitive
# future operator credential; never commit it, copy it to Vercel, or place a
# database URL/evidence payload here. The code-owned Production project hash is
# intentionally unpinned during Gate 1, so these settings alone cannot run a
# database command.
MIMI_V2_8_3_EXPECTED_BRANCH_ID=
MIMI_V2_8_3_EXPECTED_BRANCH_NAME=
MIMI_V2_8_3_PRODUCTION_MAIN_BRANCH_ID=
MIMI_V2_8_3_PRODUCTION_MAIN_ENDPOINT_ID=
MIMI_V2_8_3_CLONE_SOURCE_MAIN_BRANCH_ID=
MIMI_V2_8_3_EXPECTED_ENDPOINT_ID=
MIMI_V2_8_3_EXPECTED_DATABASE=
MIMI_V2_8_3_EXPECTED_ROLE=
MIMI_V2_8_3_NEON_PROJECT_ID=
NEON_API_KEY=
MIMI_V2_8_3_EXPECTED_CLONE_SCHEMA5_DIGEST=
MIMI_V2_8_3_EXPECTED_MAIN_SCHEMA5_DIGEST=
MIMI_V2_8_3_PRODUCTION_BACKUP_VERIFIED=
MIMI_V2_8_3_PRODUCTION_BACKUP_EVIDENCE_SHA256=
MIMI_V2_8_3_SCHEMA5_RECOVERY_POINT_CONFIRMED=
MIMI_V2_8_3_SCHEMA5_RECOVERY_BRANCH_ID=
MIMI_V2_8_3_CLONE_REHEARSAL_CONFIRMED=
MIMI_V2_8_3_CLONE_REHEARSAL_NON_EMPTY_CONFIRMED=
MIMI_V2_8_3_CLONE_REHEARSAL_EVIDENCE_SHA256=
MIMI_V2_8_3_WRITE_FREE_WINDOW_CONFIRMED=
MIMI_V2_8_3_WRITE_FREE_WINDOW_ID=
MIMI_V2_8_3_OLD_RUNTIME_WRITE_PATH_BLOCKED=
MIMI_V2_8_3_OLD_RUNTIME_WRITE_PATH_EVIDENCE_SHA256=
MIMI_V2_8_3_NO_IN_FLIGHT_WRITES_CONFIRMED=
