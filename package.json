{
  "name": "words-learning-app-for-mimi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ai:quality:dry-run": "node scripts/v2-ai-quality-runner.mjs --dry-run",
    "ai:quality:live": "dotenv -e .env.stage2.local -- node scripts/v2-ai-quality-runner.mjs --live",
    "db:migrate:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/run-sql-migration.mjs db/migrations/0001_initial.sql",
    "db:migrate:schema5:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/run-sql-migration.mjs db/migrations/0002_schema5_production_runtime.sql",
    "db:inspect:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/inspect-database-schema.mjs",
    "db:inspect:schema5:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/inspect-database-schema5.mjs",
    "db:verify:schema5-active-guard:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/verify-schema5-active-review-guard.mjs",
    "db:test:repository:dev": "MIMI_POSTGRES_INTEGRATION=1 MIMI_STORAGE_RUNTIME=postgres-preview STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- vitest run src/lib/storage/postgres/repository.integration.test.ts",
    "backup:dry-run:fixture": "node scripts/backup-import-postgres.mjs --fixture --dry-run",
    "backup:dry-run:schema5-fixture": "node scripts/backup-import-postgres.mjs --schema5-fixture --dry-run",
    "backup:dry-run:schema6-fixture": "node scripts/backup-import-postgres.mjs --schema6-fixture --dry-run",
    "db:cleanup-smoke:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --cleanup-smoke",
    "db:import-fixture-trial:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --fixture --trial-rollback",
    "db:import-schema5-fixture-trial:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --schema5-fixture --trial-rollback",
    "db:import-fixture-commit:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --fixture --commit --i-confirm-development-import",
    "db:import-schema5-fixture-commit:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --schema5-fixture --commit --i-confirm-development-import",
    "db:cleanup-fixture:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --cleanup-fixture",
    "db:cleanup-stage5n-ui-smoke:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --cleanup-stage5n-ui-smoke",
    "v2:7b2:db:inventory": "dotenv -e .env.v2-7b-2.local -- node scripts/v2-stage7b2-db.mjs inventory",
    "v2:7b2:db:migrate": "dotenv -e .env.v2-7b-2.local -- node scripts/v2-stage7b2-db.mjs migrate --i-confirm-temporary-schema6-migration",
    "v2:7b2:db:seed": "dotenv -e .env.v2-7b-2.local -- node scripts/v2-stage7b2-db.mjs seed --i-confirm-synthetic-seed",
    "v2:7b2:db:inspect": "dotenv -e .env.v2-7b-2.local -- node scripts/v2-stage7b2-db.mjs inspect",
    "v2:7b2:provider:disclosure": "dotenv -e .env.v2-7b-2.local -- node scripts/v2-stage7b2-provider-smoke.mjs disclosure",
    "v2:7b2:provider:proof": "dotenv -e .env.v2-7b-2.local -- node scripts/v2-stage7b2-provider-smoke.mjs proof --i-confirm-two-provider-attempts",
    "v2:7b2:provider:kill-switch": "dotenv -e .env.v2-7b-2.local -- node scripts/v2-stage7b2-provider-smoke.mjs kill-switch --i-confirm-kill-switch-probe",
    "v2:7b2:start": "dotenv -e .env.v2-7b-2.local -- next start -H 127.0.0.1 -p 3001",
    "v2:8-2:db:inventory": "node scripts/v2-stage8-2-db.mjs inventory",
    "v2:8-2:db:migrate": "node scripts/v2-stage8-2-db.mjs migrate --i-confirm-v2-8-2-migration",
    "v2:8-2:db:inspect": "node scripts/v2-stage8-2-db.mjs inspect-schema6",
    "v2:8-2:db:ai-evidence": "node scripts/v2-stage8-2-db.mjs ai-evidence",
    "v2:8-2:db:seed-preview": "node scripts/v2-stage8-2-db.mjs seed-preview --i-confirm-v2-8-2-synthetic-seed",
    "v2:8-2-3:tts:start": "MIMI_TTS_KILL_SWITCH=off MIMI_TTS_RUNTIME_ENABLED=true MIMI_TTS_EXECUTION_SCOPE=v2-8-2-3-local-google-adc MIMI_TTS_PROVIDER=google-cloud-standard MIMI_TTS_GCP_PROJECT=for-tts-502913 next start -H 127.0.0.1 -p 3000",
    "v2:8-2-3:tts:corpus": "node scripts/v2-stage8-2-3-tts-corpus.mjs --i-confirm-50-provider-attempts",
    "v2:8-3:db:inventory:clone": "STAGE6B_DATABASE_TARGET=production-clone MIMI_STORAGE_RUNTIME=postgres-production-clone MIMI_V2_8_3_DATABASE_TARGET=production-clone MIMI_V2_8_3_DATABASE_ACTION=inventory-schema5 node scripts/v2-stage8-3-db.mjs inventory-schema5 --i-confirm-v2-8-3-read-only-inventory",
    "v2:8-3:db:migrate:clone": "STAGE6B_DATABASE_TARGET=production-clone MIMI_STORAGE_RUNTIME=postgres-production-clone MIMI_V2_8_3_DATABASE_TARGET=production-clone MIMI_V2_8_3_DATABASE_ACTION=migrate-clone node scripts/v2-stage8-3-db.mjs migrate-clone --i-confirm-v2-8-3-clone-migration",
    "v2:8-3:db:inspect:clone": "STAGE6B_DATABASE_TARGET=production-clone MIMI_STORAGE_RUNTIME=postgres-production-clone MIMI_V2_8_3_DATABASE_TARGET=production-clone MIMI_V2_8_3_DATABASE_ACTION=inspect-schema6 node scripts/v2-stage8-3-db.mjs inspect-schema6 --i-confirm-v2-8-3-read-only-inspection",
    "v2:8-3:db:parity:clone": "STAGE6B_DATABASE_TARGET=production-clone MIMI_STORAGE_RUNTIME=postgres-production-clone MIMI_V2_8_3_DATABASE_TARGET=production-clone MIMI_V2_8_3_DATABASE_ACTION=parity-schema6 node scripts/v2-stage8-3-db.mjs parity-schema6 --i-confirm-v2-8-3-read-only-parity",
    "v2:8-3:db:inventory:main": "STAGE6B_DATABASE_TARGET=production VERCEL_ENV=production MIMI_STORAGE_RUNTIME=postgres-production MIMI_V2_8_3_DATABASE_TARGET=production-main MIMI_V2_8_3_DATABASE_ACTION=inventory-schema5 node scripts/v2-stage8-3-db.mjs inventory-schema5 --i-confirm-v2-8-3-read-only-inventory",
    "v2:8-3:db:migrate:main": "STAGE6B_DATABASE_TARGET=production VERCEL_ENV=production MIMI_STORAGE_RUNTIME=postgres-production MIMI_V2_8_3_DATABASE_TARGET=production-main MIMI_V2_8_3_DATABASE_ACTION=migrate-main node scripts/v2-stage8-3-db.mjs migrate-main --i-confirm-v2-8-3-production-migration",
    "v2:8-3:db:inspect:main": "STAGE6B_DATABASE_TARGET=production VERCEL_ENV=production MIMI_STORAGE_RUNTIME=postgres-production MIMI_V2_8_3_DATABASE_TARGET=production-main MIMI_V2_8_3_DATABASE_ACTION=inspect-schema6 node scripts/v2-stage8-3-db.mjs inspect-schema6 --i-confirm-v2-8-3-read-only-inspection",
    "v2:8-3:db:parity:main": "STAGE6B_DATABASE_TARGET=production VERCEL_ENV=production MIMI_STORAGE_RUNTIME=postgres-production MIMI_V2_8_3_DATABASE_TARGET=production-main MIMI_V2_8_3_DATABASE_ACTION=parity-schema6 node scripts/v2-stage8-3-db.mjs parity-schema6 --i-confirm-v2-8-3-read-only-parity",
    "v2:8-3:manifest:template": "node scripts/v2-stage8-3-cutover-manifest.mjs template",
    "v2:8-3:manifest:validate": "node scripts/v2-stage8-3-cutover-manifest.mjs validate",
    "v2:8-3:backup:tools": "node scripts/v2-stage8-3-backup.mjs tools",
    "v2:8-3:backup:identity": "node scripts/v2-stage8-3-backup.mjs create-identity --i-confirm-v2-8-3-create-backup-identity",
    "v2:8-3:backup:synthetic": "node scripts/v2-stage8-3-backup.mjs synthetic --i-confirm-v2-8-3-synthetic-backup-rehearsal",
    "v2:8-3:backup:production": "node scripts/v2-stage8-3-backup.mjs production --i-confirm-v2-8-3-production-encrypted-backup",
    "db:inspect:schema5:prod": "STAGE6B_DATABASE_TARGET=production MIMI_PRODUCTION_DATABASE_ACTION=inspect VERCEL_ENV=production node scripts/inspect-database-schema5-production.mjs --i-confirm-production-read",
    "governance:preflight": "python3 governance/preflight.py --tier 3 --strict-side-effects --require-skill-marker"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/functions": "^3.7.5",
    "google-auth-library": "^10.9.0",
