{
  "name": "words-learning-app-for-mimi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/run-sql-migration.mjs db/migrations/0001_initial.sql",
    "db:inspect:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/inspect-database-schema.mjs",
    "backup:dry-run:fixture": "node scripts/backup-import-postgres.mjs --fixture --dry-run",
    "db:cleanup-smoke:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --cleanup-smoke",
    "db:import-fixture-trial:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --fixture --trial-rollback",
    "db:import-fixture-commit:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --fixture --commit --i-confirm-development-import",
    "db:cleanup-fixture:dev": "STAGE5F_DATABASE_TARGET=development dotenv -e .env.local -- node scripts/backup-import-postgres.mjs --cleanup-fixture",
    "governance:preflight": "python3 governance/preflight.py --tier 1 --require-skill-marker"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
