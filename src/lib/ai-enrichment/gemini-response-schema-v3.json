{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "additionalMeaningsZh": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "sourceExampleTranslationsZh": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "type": "string" },
      "description": "Chinese translations aligned by index with every existing English example supplied in the request. Every translation must be non-empty."
    },
    "examples": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "exampleTranslationsZh": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "Chinese translations aligned by index with examples. Every translation must be non-empty."
    },
    "similarWords": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "word": { "type": "string" },
